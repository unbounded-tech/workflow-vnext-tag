{
  "extends": [
    "config:recommended"
  ],
  "semanticCommits": "enabled",
  "packageRules": [
    {
      "matchManagers": [
        "github-actions",
        "custom.regex"
      ],
      "semanticCommitType": "fix"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "pinDigests": true
    },
    {
      "matchPackageNames": [
        "houseabsolute/ubi"
      ],
      "groupName": "ubi bootstrap",
      "groupSlug": "ubi-bootstrap"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.yaml$/"
      ],
      "matchStrings": [
        "\\s*ubi --project (?<depName>.*) --tag (?<currentValue>.*?)\\s"
      ],
      "datasourceTemplate": "github-releases",
      "registryUrlTemplate": "https://github.com"
    },
    {
      "customType": "regex",
      "description": "Update the ubi bootstrap source commit and installed release together",
      "managerFilePatterns": [
        "/^\\.github/workflows/workflow\\.yaml$/"
      ],
      "matchStrings": [
        "UBI_BOOTSTRAP_REVISION: (?<currentDigest>[a-f0-9]{40}) # (?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)",
        "\\n[ \\t]+TAG: (?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "depNameTemplate": "houseabsolute/ubi",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver"
    }
  ]
}
